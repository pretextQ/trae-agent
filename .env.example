# trae-agent 运行配置模板 —— 复制为 .env 并填入真实值;.env 已被 .gitignore 排除
# 配置名来自 DEVELOPMENT.md 第 3 节的建议约定
AGENT_MODEL_ID=mimo-v2.6-flash
AGENT_MODEL_BASE_URL=https://api.xiaomimimo.com/v1
AGENT_MODEL_API_KEY=sk-your-mimo-api-key
AGENT_THINKING=enabled

# 付费运行前置条件:无明确预算不得发起任何模型调用
AGENT_RUN_BUDGET_RMB=1

# 独立高熵 Agent 服务 Bearer 凭据(≥32 字符),例如: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_HTTP_TOKEN=replace-with-random-token-at-least-32-chars

# 版本与 Eyes 源码基线(compose 以只读方式挂载该 checkout 到 /opt/eyes)
AGENT_VERSION=0.1.0
AGENT_EYES_BASELINE=67d2195
EYES_REPO=/absolute/path/to/eyes-checkout

# 可选限额(括号内为默认值)
# AGENT_MAX_CONCURRENCY=1
# AGENT_MAX_MODEL_CALLS=24
# AGENT_MAX_TOOL_CALLS=48
# AGENT_MAX_OUTPUT_TOKENS=2048
# AGENT_REQUEST_TIMEOUT_SECONDS=120
# AGENT_TOOL_TIMEOUT_SECONDS=20
# AGENT_CAPTURE_MODEL_IO=false
# AGENT_PRICE_INPUT_PER_M=1.0
# AGENT_PRICE_CACHE_READ_PER_M=0.02
# AGENT_PRICE_OUTPUT_PER_M=2.0
